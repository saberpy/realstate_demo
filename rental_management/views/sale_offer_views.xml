<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="property_sale_offer_list_view" model="ir.ui.view">
        <field name="name">property.sale.offer.list</field>
        <field name="model">property.sale.offer.template</field>
        <field name="arch" type="xml">
            <list string="Sale Offers">
                <field name="name"/>
                <field name="state" widget="badge" 
                    decoration-success="state == 'published'"
                    decoration-muted="state == 'archived'"/>
            </list>
        </field>
    </record>

    <record id="property_sale_offer_form_view" model="ir.ui.view">
        <field name="name">property.sale.offer.form</field>
        <field name="model">property.sale.offer.template</field>
        <field name="arch" type="xml">
            <form string="Sale Offer">
                <header>
                    <button name="action_publish" type="object" string="Publish" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_archive" type="object" string="Archive" class="btn-secondary"
                            invisible="state == 'archived'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,published,archived"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="payment_total_percent" readonly="1" widget="percentage"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payment Lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="sequence"/>
                                    <field name="due_date"/>
                                    <field name="amount_type"/>
                                    <field name="percentage" widget="percentage"
                                           invisible="amount_type != 'percentage'"/>
                                    <field name="fixed_amount" widget="monetary"
                                           invisible="amount_type != 'fixed'"/>
                                    <field name="description" optional="hide"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" readonly="state != 'draft'" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="property_sale_offer_search_view" model="ir.ui.view">
        <field name="name">property.sale.offer.search</field>
        <field name="model">property.sale.offer.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Published" name="published" domain="[('state', '=', 'published')]"/>
            </search>
        </field>
    </record>

    <record id="property_sale_offer_action" model="ir.actions.act_window">
        <field name="name">Sale Offers</field>
        <field name="res_model">property.sale.offer.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="property_sale_offer_search_view"/>
    </record>

    <record id="property_details_offers_list_view" model="ir.ui.view">
        <field name="name">property.details.offers.list</field>
        <field name="model">property.details.offers</field>
        <field name="arch" type="xml">
            <list string="Unit Offers">
                <field name="property_id"/>
                <field name="offer_template_id"/>
                <field name="customer_id"/>
                <field name="total_installments"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="unit_price" widget="monetary"/>
                <field name="schedule_total" widget="monetary"/>
            </list>
        </field>
    </record>

    <record id="property_details_offers_form_view" model="ir.ui.view">
        <field name="name">property.details.offers.form</field>
        <field name="model">property.details.offers</field>
        <field name="arch" type="xml">
            <form string="Unit Offer">
                <header>
                    <button name="action_generate_schedule" type="object" string="Regenerate Schedule"
                            class="btn-secondary"/>
                    <button name="action_get_offer_report" type="object" string="Print Statement of Account"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="property_id"/>
                            <field name="offer_template_id" domain="[('state', '=', 'published')]"/>
                            <field name="customer_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="unit_price" readonly="1" widget="monetary"/>
                            <field name="total_installments"/>
                            <field name="start_date"/>
                            <field name="schedule_total" readonly="1" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payment Schedule">
                            <field name="line_ids">
                                <list editable="bottom" decoration-danger="status == 'overdue'"
                                      decoration-success="status == 'fully_paid'"
                                      decoration-muted="status == 'not_due'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="due_date"/>
                                    <field name="percentage" widget="percentage"/>
                                    <field name="amount" widget="monetary" readonly="1"/>
                                    <field name="paid_amount" widget="monetary"/>
                                    <field name="balance" widget="monetary" readonly="1"/>
                                    <field name="status" widget="badge"/>
                                    <field name="is_statutory_charge" optional="hide"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="property_details_offers_action" model="ir.actions.act_window">
        <field name="name">Unit Offers</field>
        <field name="res_model">property.details.offers</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
