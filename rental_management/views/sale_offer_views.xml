<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="property_sale_offer_list_view" model="ir.ui.view">
        <field name="name">property.sale.offer.list</field>
        <field name="model">property.sale.offer.template</field>
        <field name="arch" type="xml">
            <list string="Sale Offers">
                <field name="name"/>
                <field name="state" widget="badge" 
                    decoration-success="state == 'published'"
                    decoration-muted="state == 'archived'"/>
            </list>
        </field>
    </record>

    <record id="property_sale_offer_form_view" model="ir.ui.view">
        <field name="name">property.sale.offer.form</field>
        <field name="model">property.sale.offer.template</field>
        <field name="arch" type="xml">
            <form string="Sale Offer">
                <header>
                    <button name="action_publish" type="object" string="Publish" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_archive" type="object" string="Archive" class="btn-secondary"
                            invisible="state == 'archived'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,published,archived"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="payment_total_percent" readonly="1" widget="percentage"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payment Lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="sequence"/>
                                    <field name="due_date"/>
                                    <field name="percentage" widget="percentage"/>
                                    <field name="description" optional="hide"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" readonly="state != 'draft'" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="property_sale_offer_search_view" model="ir.ui.view">
        <field name="name">property.sale.offer.search</field>
        <field name="model">property.sale.offer.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Published" name="published" domain="[('state', '=', 'published')]"/>
            </search>
        </field>
    </record>

    <record id="property_sale_offer_action" model="ir.actions.act_window">
        <field name="name">Sale Offers</field>
        <field name="res_model">property.sale.offer.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="property_sale_offer_search_view"/>
    </record>

</odoo>
