<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="property_sale_offer_list_view" model="ir.ui.view">
        <field name="name">property.sale.offer.list</field>
        <field name="model">property.sale.offer</field>
        <field name="arch" type="xml">
            <list string="Sale Offers" default_order="offer_date desc, id desc">
                <field name="name"/><field name="offer_date"/>
                <field name="offer_price" widget="monetary"/><field name="payment_total" widget="monetary"/>
                <field name="state" widget="badge" decoration-success="state == 'published'"
                       decoration-muted="state == 'archived'"/>
            </list>
        </field>
    </record>

    <record id="property_sale_offer_form_view" model="ir.ui.view">
        <field name="name">property.sale.offer.form</field>
        <field name="model">property.sale.offer</field>
        <field name="arch" type="xml">
            <form string="Sale Offer">
                <header>
                    <button name="action_publish" type="object" string="Publish" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="%(sale_offer_payment_generator_action)d" type="action"
                            string="Generate Payment Schedule" class="btn-secondary"
                            invisible="state != 'draft'"/>
                    <button name="action_archive" type="object" string="Archive" class="btn-secondary"
                            invisible="state == 'archived'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,published,archived"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="offer_date" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="offer_price" widget="monetary" readonly="state != 'draft'"/>
                            <field name="payment_total" widget="monetary" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payment Methods">
                            <field name="payment_line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/><field name="name"/>
                                    <field name="due_date"/><field name="amount" widget="monetary"/>
                                    <field name="percentage" optional="hide"/>
                                    <field name="description" optional="hide"/><field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Units">
                            <field name="unit_offer_ids" readonly="state != 'draft'">
                                <list editable="bottom" decoration-danger="state == 'expired'"
                                      decoration-muted="state == 'cancelled'">
                                    <field name="property_id"/><field name="customer_id" readonly="1"/>
                                    <field name="valid_until"
                                           decoration-danger="valid_until and valid_until &lt; current_date and state in ('available', 'customer_selected')"/>
                                    <field name="state" readonly="1" widget="badge"
                                           decoration-success="state == 'contracted'"
                                           decoration-info="state == 'customer_selected'"
                                           decoration-danger="state == 'expired'"
                                           decoration-muted="state == 'cancelled'"/>
                                    <field name="contract_id" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes"><field name="notes" readonly="state != 'draft'" nolabel="1"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="property_sale_offer_unit_list_view" model="ir.ui.view">
        <field name="name">property.sale.offer.unit.list</field>
        <field name="model">property.sale.offer.unit</field>
        <field name="arch" type="xml">
            <list string="Unit Sale Offers" decoration-danger="state == 'expired'"
                  decoration-muted="state == 'cancelled'">
                <field name="property_id"/><field name="offer_id"/><field name="customer_id"/>
                <field name="valid_until"
                       decoration-danger="valid_until and valid_until &lt; current_date and state in ('available', 'customer_selected')"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'contracted'"
                       decoration-info="state == 'customer_selected'"
                       decoration-danger="state == 'expired'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="contract_id"/>
                <button name="action_customer_select" type="object" string="Customer Select"
                        invisible="state != 'available'"/>
                <button name="action_seller_confirm" type="object" string="Seller Confirm"
                        invisible="state != 'customer_selected'"/>
            </list>
        </field>
    </record>

    <record id="property_sale_offer_unit_form_view" model="ir.ui.view">
        <field name="name">property.sale.offer.unit.form</field>
        <field name="model">property.sale.offer.unit</field>
        <field name="arch" type="xml">
            <form string="Unit Sale Offer">
                <header>
                    <button name="action_customer_select" type="object" string="Customer Selects This Offer"
                            class="btn-primary" invisible="state != 'available'"/>
                    <button name="action_seller_confirm" type="object" string="Seller Confirm &amp; Create Contract"
                            class="btn-success" invisible="state != 'customer_selected'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="available,customer_selected,contracted,expired,cancelled"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Expired" bg_color="text-bg-danger" invisible="state != 'expired'"/>
                    <group>
                        <group><field name="property_id" readonly="1"/><field name="customer_id" readonly="1"/></group>
                        <group><field name="offer_id" readonly="1"/><field name="contract_id" readonly="1"/>
                            <field name="valid_until" readonly="state not in ('available', 'customer_selected')"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="property_sale_offer_search_view" model="ir.ui.view">
        <field name="name">property.sale.offer.search</field><field name="model">property.sale.offer</field>
        <field name="arch" type="xml"><search><field name="name"/><filter string="Published" name="published" domain="[('state', '=', 'published')]"/></search></field>
    </record>
    <record id="property_sale_offer_action" model="ir.actions.act_window">
        <field name="name">Sale Offers</field><field name="res_model">property.sale.offer</field>
        <field name="view_mode">list,form</field><field name="search_view_id" ref="property_sale_offer_search_view"/>
    </record>

    <record id="property_sale_offer_unit_search_view" model="ir.ui.view">
        <field name="name">property.sale.offer.unit.search</field>
        <field name="model">property.sale.offer.unit</field>
        <field name="arch" type="xml">
            <search>
                <field name="property_id"/>
                <field name="offer_id"/>
                <field name="customer_id"/>
                <filter string="Available" name="available" domain="[('state', '=', 'available')]"/>
                <filter string="Selected by Customer" name="customer_selected" domain="[('state', '=', 'customer_selected')]"/>
                <filter string="Contracted" name="contracted" domain="[('state', '=', 'contracted')]"/>
                <filter string="Expired" name="expired" domain="[('state', '=', 'expired')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Expiring Soon" name="expiring_soon"
                        domain="[('state', 'in', ('available', 'customer_selected')), ('valid_until', '!=', False), ('valid_until', '&gt;=', context_today().strftime('%Y-%m-%d')), ('valid_until', '&lt;=', (context_today() + relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Unit" name="group_property" context="{'group_by': 'property_id'}"/>
                    <filter string="Offer" name="group_offer" context="{'group_by': 'offer_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
