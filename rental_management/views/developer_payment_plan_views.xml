<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- Tree View -->
    <!-- ========================================================= -->

    <record id="developer_payment_plan_tree_view" model="ir.ui.view">
        <field name="name">developer.payment.plan.tree</field>
        <field name="model">developer.payment.plan</field>
        <field name="arch" type="xml">
            <list string="Payment Plans" default_order="name">
                <field name="name"/>
                <field name="project_id"/>
                <field name="down_payment_percent"/>
                <field name="handover_payment_percent"/>
                <field name="installment_count"/>
                <field name="admin_fee" widget="monetary"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ========================================================= -->
    <!-- Form View -->
    <!-- ========================================================= -->

    <record id="developer_payment_plan_form_view" model="ir.ui.view">
        <field name="name">developer.payment.plan.form</field>
        <field name="model">developer.payment.plan</field>
        <field name="arch" type="xml">
            <form string="Payment Plan">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="General Information">
                            <field name="project_id"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                            <field name="currency_id"
                                   invisible="1"/>
                            <field name="active"/>
                        </group>
                        <group string="Payment Configuration">
                            <field name="down_payment_percent"/>
                            <field name="handover_payment_percent"/>
                            <field name="installment_count"/>
                            <field name="dld_fee_percent"/>
                            <field name="admin_fee"
                                   widget="monetary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"
                                   nolabel="1"
                                   placeholder="Payment plan description..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ========================================================= -->
    <!-- Action -->
    <!-- ========================================================= -->

    <record id="developer_payment_plan_action" model="ir.actions.act_window">
        <field name="name">Payment Plans</field>
        <field name="res_model">developer.payment.plan</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="developer_payment_plan_tree_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Payment Plan
            </p>
            <p>
                Payment Plans define the down payment, installment schedule,
                DLD fee and handover payment configuration for developer projects.
            </p>
        </field>
    </record>

</odoo>