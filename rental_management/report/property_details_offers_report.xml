<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="property_details_offers_qweb_report_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <style>
                            body { font-family: 'Helvetica Neue', Arial, sans-serif; }

                            /* ---- Logo pill (mimics the dark rounded brand badge) ---- */
                            .logo-pill {
                                background:#1a1a1a;
                                border-radius: 30px;
                                padding: 10px 22px;
                                display:inline-block;
                                margin-bottom: 18px;
                            }
                            .logo-pill img { max-height:32px; display:block; }
                            .logo-pill .logo-text {
                                color:#fff;
                                font-weight:700;
                                letter-spacing:2px;
                                font-size:16px;
                                text-transform:uppercase;
                            }
                            .logo-pill .logo-subtext {
                                color:#cfcfcf;
                                font-size:8px;
                                letter-spacing:3px;
                                text-transform:uppercase;
                                display:block;
                                margin-top:1px;
                            }

                            h1 {
                                font-size: 20px;
                                text-transform: uppercase;
                                margin-bottom: 4px;
                                color:#1a1a1a;
                                font-weight:700;
                            }
                            .subtitle { color:#777; margin-bottom:15px; font-size:11px; }

                            h2 {
                                font-size: 12px;
                                font-weight:700;
                                margin-top: 20px;
                                margin-bottom: 8px;
                                text-transform: uppercase;
                                letter-spacing:1px;
                                color:#1a1a1a;
                                border-bottom: 2px solid #1a1a1a;
                                padding-bottom: 4px;
                            }

                            /* ---- Zebra-striped, borderless-column table like the reference ---- */
                            .data-table { width:100%; border-collapse:collapse; }
                            .data-table th {
                                text-align: left;
                                font-size: 10px;
                                font-weight:700;
                                text-transform:uppercase;
                                letter-spacing:0.5px;
                                color:#1a1a1a;
                                padding:8px 10px;
                                border-bottom: 2px solid #1a1a1a;
                            }
                            .data-table td {
                                font-size: 11px;
                                padding:8px 10px;
                                color:#333;
                                vertical-align: top;
                            }
                            .data-table tbody tr:nth-child(even) { background-color:#f4f2f8; }
                            .data-table tbody tr:nth-child(odd)  { background-color:#ffffff; }

                            .text-right { text-align:right; }

                            /* ---- Two-line dual currency amount cell ---- */
                            .amount-main {
                                display:block;
                                font-weight:700;
                                color:#1a1a1a;
                            }
                            .amount-sub {
                                display:block;
                                font-size:10px;
                                color:#888;
                                margin-top:1px;
                            }

                            .status-fully_paid { color:#2e7d32; font-weight:bold; }
                            .status-overdue { color:#c62828; font-weight:bold; }
                            .status-partially_paid { color:#ef6c00; font-weight:bold; }
                            .status-not_due { color:#777; }

                            tr.total-row td { font-weight:bold; border-top:2px solid #1a1a1a; background-color:#fff !important; }
                        </style>
                        <div class="page">

                            <!-- Brand badge: uses the company logo if set, otherwise falls back to the company name -->
                            <div class="logo-pill">
                                <img t-if="o.property_id.property_project_id.company_id.logo"
                                     t-att-src="image_data_uri(o.property_id.property_project_id.company_id.logo)"/>
                                <t t-else="">
                                    <span class="logo-text" t-esc="o.property_id.property_project_id.company_id.name"/>
                                    <span class="logo-subtext">Development</span>
                                </t>
                            </div>

                            <h1>Statement of Account</h1>
                            <div class="subtitle">
                                <span t-field="o.property_id.property_project_id.name"/>
                                <span> &#183; </span>
                                <span t-field="o.property_id.name"/>
                                <span> &#183; </span>
                                <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%b-%Y')"/>
                            </div>

                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Project</th>
                                        <th>Unit No.</th>
                                        <th>Unit Type</th>
                                        <th>Buyer Name</th>
                                        <th>Contact No</th>
                                        <th>Project Completion</th>
                                        <th class="text-right">Unit Price</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>
                                            <span t-field="o.property_id.property_project_id.name"/>
                                        </td>
                                        <td>
                                            <span t-field="o.property_id.name"/>
                                        </td>
                                        <td>
                                            <span t-field="o.property_id.property_subtype_id.name"/>
                                        </td>
                                        <td>
                                            <span t-field="o.customer_id.name"/>
                                        </td>
                                        <td>
                                            <span t-field="o.customer_id.phone"/>
                                        </td>
                                        <td>
                                            <span t-field="o.property_id.property_project_id.status"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-field="o.unit_price" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                            <h2 t-if="o.line_ids.filtered(lambda l: l.is_statutory_charge)">Statutory Charges</h2>
                            <table class="data-table" t-if="o.line_ids.filtered(lambda l: l.is_statutory_charge)">
                                <thead>
                                    <tr>
                                        <th>Statutory Component</th>
                                        <th>Date</th>
                                        <th class="text-right">Amount</th>
                                        <th class="text-right">Receipt</th>
                                        <th class="text-right">Balance Due</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.line_ids.filtered(lambda l: l.is_statutory_charge)" t-as="line">
                                        <tr>
                                            <td>
                                                <span t-field="line.name"/>
                                            </td>
                                            <td>
                                                <span t-field="line.due_date"/>
                                            </td>
                                            <td class="text-right">
                                                <span t-field="line.amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                            </td>
                                            <td class="text-right">
                                                <span t-field="line.paid_amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                            </td>
                                            <td class="text-right">
                                                <span t-field="line.balance" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>

                            <h2>Payment Plan with Balance</h2>
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Description</th>
                                        <th>Percentage</th>
                                        <th>Date</th>
                                        <th class="text-right">Amount</th>
                                        <th class="text-right">Receipt / Adjusted</th>
                                        <th class="text-right">Balance</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.line_ids.filtered(lambda l: not l.is_statutory_charge)" t-as="line">
                                        <tr>
                                            <td>
                                                <span t-field="line.name"/>
                                            </td>
                                            <td>
                                                <span t-out="line.percentage"/>%
                                            </td>
                                            <td>
                                                <span t-field="line.due_date"/>
                                            </td>
                                            <td class="text-right">
                                                <!-- Line 1: amount in the offer's own currency -->
                                                <span class="amount-main"
                                                      t-field="line.amount"
                                                      t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                                <!-- Line 2: USD equivalent, computed via Odoo's live currency conversion -->
                                                <span class="amount-sub"
                                                      t-esc="'$ %s' % '{:,.2f}'.format(
                                                          line.currency_id._convert(
                                                              line.amount,
                                                              env.ref('base.USD'),
                                                              o.property_id.property_project_id.company_id,
                                                              line.due_date or datetime.date.today()
                                                          )
                                                      )"
                                                      t-if="line.currency_id != env.ref('base.USD')"/>
                                            </td>
                                            <td class="text-right">
                                                <span t-field="line.paid_amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                            </td>
                                            <td class="text-right">
                                                <span t-field="line.balance" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                            </td>
                                            <td t-attf-class="status-{{line.status}}">
                                                <span t-if="line.status == 'fully_paid'">Fully Paid</span>
                                                <span t-if="line.status == 'partially_paid'">Partially Paid</span>
                                                <span t-if="line.status == 'overdue'">Overdue</span>
                                                <span t-if="line.status == 'not_due'">Not Yet Due</span>
                                            </td>
                                        </tr>
                                    </t>
                                    <tr class="total-row">
                                        <td colspan="3">Total</td>
                                        <td class="text-right">
                                            <span t-field="o.schedule_total" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </td>
                                        <td colspan="3"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </t>
                </t>
            </t>
        </template>

        <record id="action_report_property_details_offers" model="ir.actions.report">
            <field name="name">Statement of Account</field>
            <field name="model">property.details.offers</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">rental_management.property_details_offers_qweb_report_template</field>
            <field name="report_file">rental_management.property_details_offers_qweb_report_template</field>
            <field name="binding_model_id" ref="model_property_details_offers"/>
            <field name="binding_type">report</field>
            <field name="print_report_name">'Statement of Account - %s' % (object.property_id.name)</field>
        </record>
    </data>
</odoo>