"                        <p style=\"margin-bottom:9px; color:#181C32; font-size: 22px; font-weight:700\">\n"
"                            <span t-esc=\"object.company_id.property_mail_template_title\">\n"
"                                Discover Your Ideal Property\n"
"                            </span>\n"
"                        </p>\n"
