"                    <strong>\n"
"                        <div t-out=\"object.company_id.name\" style=\"margin:10px 0px;\"/>\n"
"                    </strong>\n"
"                    <div style=\"margin-bottom: 15px\">\n"
"                        <img t-if=\"object.company_id.mail_template_image\" t-attf-src=\"/web/image/res.company/{{object.company_id.id}}/mail_template_image\" alt=\"Logo\" style=\"height:120px;width:120px;\"/>\n"
"\n"
"                        <img t-else=\"\" src=\"/rental_management/static/src/img/icon-positive-vote.png\" alt=\"Logo\"/>\n"
"                    </div>\n"
