"<span style=\"font-size:13px;\" t-field=\"object.company_id.email\"></span>\n"
"</a>\n"
"                                |\n"
"                            </t>\n"
"<a href=\"${object.company_id.website%20or%20'#'}\" target=\"_blank\">\n"
"<span style=\"font-size:13px;\" t-field=\"object.company_id.website\"></span>\n"
"</a>\n"
"</p>\n"
"</div>\n"
