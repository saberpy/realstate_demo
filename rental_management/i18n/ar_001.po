"                            What's New?\n"
"                        </span>\n"
"                    </p>\n"
"                    <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"width: 100%; max-width: 500px; background-color: #F9F9F9; border-radius: 12px; border-collapse: separate; padding: 20px;\">\n"
