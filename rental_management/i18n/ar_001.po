#. module: rental_management
#: model:mail.template,body_html:rental_management.active_contract_mail_template_new
msgid ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px; color: #333;text-align:center;\">\n"
"                    <img t-attf-src=\"data:image/*;base64,{{object.company_id.logo}}\" style=\"border-radius: 12px;\" alt=\"Company Logo\" height=\"60\"/>\n"
"                    <strong>\n"
"                        <div t-out=\"object.company_id.name\" style=\"margin:10px 0px;\"/>\n"
"                    </strong>\n"
"                    <div style=\"margin-bottom: 15px\">\n"
"\n"
"                        <img t-if=\"object.company_id.contract_mail_template_image\" t-attf-src=\"/web/image/res.company/{{object.company_id.id}}/contract_mail_template_image\" alt=\"Logo\" style=\"height:120px;width:120px;\"/>\n"
"\n"
"                        <img t-else=\"\" src=\"/rental_management/static/src/img/icon-positive-vote.png\" alt=\"Logo\"/>\n"
"                    </div>\n"
"                    <div style=\"font-size: 14px; font-weight: 500; margin-bottom: 27px; font-family:Arial,Helvetica,sans-serif;\">\n"
"                        <p style=\"margin-bottom:9px; color:#181C32; font-size: 22px; font-weight:700\">\n"
"                            Your Rental Agreement Is Now Active\n"
"                        </p>\n"
"                        <p style=\"margin:0px 20px 2px 20px;color:#7E8299\">\n"
"                            <strong>\n"
"                                Dear<t t-out=\"object.tenancy_id.name\"/>, Your journey begins here.\n"
"                            </strong>\n"
"                            <br/>\n"
"                            Welcome to your new space we are delighted to have you with us. Please take a moment to\n"
"                            review the attached Contract Details PDF to ensure all information is correct.\n"
"                            If you have any questions, our team is here to help you.\n"
"                        </p>\n"
"                    </div>\n"
"                    <p style=\"color: #181C32; font-size: 18px; font-weight: 600; margin-bottom: 15px;\">\n"
"                        <span t-esc=\"object.company_id.section_title\">\n"
"                            Rent Contract\n"
"                        </span>\n"
"                    </p>\n"
"                    <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"width: 80%; max-width: 500px; background-color: #F9F9F9; border-radius: 12px; border-collapse: separate; padding: 20px;\">\n"
"                        <!-- Step 1 -->\n"
"                        <tr>\n"
"                            <td>\n"
"                                <div style=\"margin-right:10px; background: #fff; width: 40px; height: 40px; text-align: center; font-size: 17px; color: #50cd89; font-weight: 600; border-radius: 50%; display: flex; align-items: center; justify-content: center;\">\n"
"                                    <span>1</span>\n"
"                                </div>\n"
"                            </td>\n"
"                            <td style=\"text-align: left; padding: 15px 0; border-bottom: 1px dashed #E4E6EF;\">\n"
"                                <div style=\"color: #181C32; font-size: 14px; font-weight: 600; text-decoration: none; font-family: Arial, sans-serif;\">\n"
"                                    Property Details\n"
"                                </div>\n"
"                                <p style=\"color: #5E6278; font-size: 13px; font-weight: 500; margin: 5px 0 0 0; line-height: 1.4;\">\n"
"                                    <span style=\"font-weight:700;\">\n"
"                                        <t t-out=\"object.property_id.name\"/>\n"
"                                    </span>\n"
"                                </p>\n"
"                                <p style=\"color: #5E6278; font-size: 13px; font-weight: 500; margin: 5px 0 0 0; line-height: 1.4;\">\n"
"                                    <strong>Type :</strong>\n"
"                                    <span>\n"
"                                        <span t-field=\"object.property_type\"/>\n"
"                                        ,\n"
"                                        <span t-field=\"object.property_subtype_id.name\"/>\n"
"                                    </span>\n"
"                                </p>\n"
"                                <p style=\"color: #5E6278; font-size: 13px; font-weight: 500; margin: 5px 0 0 0; line-height: 1.4;\" t-if=\"object.property_id.street or object.property_id.street2 or object.property_id.city_id or object.property_id.state_id or object.property_id.zip or object.property_id.country_id\">\n"
"                                    <strong>Address :</strong>\n"
"                                    <span>\n"
"                                        <t t-esc=\"', '.join(filter(None, [                                             object.property_id.street or '',                                             object.property_id.street2 or '',                                             object.property_id.city_id.name or '',                                             object.property_id.state_id and object.property_id.state_id.name or '',                                             object.property_id.zip or '',                                             object.property_id.country_id.name or '',                                         ]))\"/>\n"
"                                    </span>\n"
"                                </p>\n"
"                            </td>\n"
"                        </tr>\n"
"                        <!-- Step 2 -->\n"
"                        <tr>\n"
"                            <td>\n"
"                                <div style=\"margin-right:10px; background: #fff; width: 40px; height: 40px; text-align: center; font-size: 17px; color: #50cd89; font-weight: 600; border-radius: 50%; display: flex; align-items: center; justify-content: center;\">\n"
"                                    <span>2</span>\n"
"                                </div>\n"
"                            </td>\n"
"                            <td style=\"text-align: left; padding: 15px 0;\">\n"
"                                <div style=\"color: #181C32; font-size: 14px; font-weight: 600; text-decoration: none; font-family: Arial, sans-serif;\">\n"
"                                    Contract Detail\n"
"                                </div>\n"
"                                <p style=\"color: #5E6278; font-size: 13px; font-weight: 500; margin: 5px 0 0 0; line-height: 1.4;\">\n"
"                                    <strong>Duration :</strong>\n"
"                                    <span>\n"
"                                        <t t-out=\"object.start_date\"/>\n"
"                                        -\n"
"                                        <t t-out=\"object.end_date\"/>\n"
"                                    </span>\n"
"                                    <br/>\n"
"                                    <strong>Rent :</strong>\n"
"                                    <span t-field=\"object.total_rent\"/>\n"
"                                    /\n"
"                                    <span t-field=\"object.rent_unit\"/>\n"
"                                    <br/>\n"
"                                    <strong>Security Deposit :</strong>\n"
"                                    <span t-field=\"object.deposit_amount\"/>\n"
"                                </p>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </table>\n"
"                    <div align=\"center\" valign=\"center\" style=\"font-size: 13px; text-align:center; padding: 0 10px 10px 10px; font-weight: 500; color: #A1A5B7; font-family:Arial,Helvetica,sans-serif\">\n"
"                        <p style=\"color:#5E6278; font-size: 16px; font-weight: 600; margin-bottom:9px\">\n"
"                            Please refer to the attached document for further details.\n"
"                        </p>\n"
"                        <p>\n"
"                            <strong>Happy to Help</strong>\n"
"                            <br/>\n"
"                            Have a question or need help? We’re always happy to assist you.\n"
"                            <br/>\n"
"                            <t t-if=\"object.company_id.phone\">\n"
"                                <a t-attf-href=\"tel:{{ object.company_id.phone }}\">\n"
"                                    <span t-field=\"object.company_id.phone\" style=\"font-size:13px;\"/>\n"
"                                </a>\n"
"                                |\n"
"                            </t>\n"
"                            <t t-if=\"object.company_id.email\">\n"
"                                <a t-attf-href=\"mailto:{{ object.company_id.email }}\">\n"
"                                    <span t-field=\"object.company_id.email\" style=\"font-size:13px;\"/>\n"
"                                </a>\n"
"                                |\n"
"                            </t>\n"
"                            <a href=\"${object.company_id.website%20or%20'#'}\" target=\"_blank\">\n"
"                                <span t-field=\"object.company_id.website\" style=\"font-size:13px;\"/>\n"
"                            </a>\n"
"                        </p>\n"
"                    </div>\n"
"                </div>\n"
"\n"
"\n"
"                <div style=\"margin-bottom:20px;\">\n"
"                    <div align=\"center\" valign=\"center\" style=\"text-align:center; padding-bottom: 20px;\">\n"
"                        <a t-attf-href=\"{{ object.company_id.social_linkedin or '#' }}\" target=\"_blank\">\n"
"                            <img alt=\"Logo\" src=\"/rental_management/static/src/img/icon-linkedin.png\"/>\n"
"                        </a>\n"
"                        <a t-attf-href=\"{{ object.company_id.social_facebook or '#' }}\" target=\"_blank\">\n"
"                            <img alt=\"Logo\" src=\"/rental_management/static/src/img/icon-facebook.png\"/>\n"
"                        </a>\n"
"                        <a t-attf-href=\"{{ object.company_id.social_twitter or '#' }}\" target=\"_blank\">\n"
"                            <img alt=\"Logo\" src=\"/rental_management/static/src/img/icon-twitter.png\"/>\n"
"                        </a>\n"
"                    </div>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px; color: #333;text-align:center;\">\n"
"<img alt=\"Company Logo\" height=\"60\" style=\"border-radius: 12px;\" t-attf-src=\"data:image/*;base64,{{object.company_id.logo}}\"/>\n"
"<strong>\n"
"<div style=\"margin:10px 0px;\" t-out=\"object.company_id.name\"></div>\n"
"</strong>\n"
"<div style=\"margin-bottom: 15px\">\n"
"<img alt=\"Logo\" style=\"height:120px;width:120px;\" t-attf-src=\"/web/image/res.company/{{object.company_id.id}}/contract_mail_template_image\" t-if=\"object.company_id.contract_mail_template_image\"/>\n"
"<img alt=\"Logo\" src=\"/rental_management/static/src/img/icon-positive-vote.png\" t-else=\"\"/>\n"
"</div>\n"
"<div style=\"font-size: 14px; font-weight: 500; margin-bottom: 27px; font-family:Arial,Helvetica,sans-serif;\">\n"
"<p style=\"margin-bottom:9px; color:#181C32; font-size: 22px; font-weight:700\">\n"
"                            أصبحت اتفاقية الإيجار الخاصة بك نشطة الآن\n"
"                        </p>\n"
"<p style=\"margin:0px 20px 2px 20px;color:#7E8299\">\n"
"<strong>\n"
"                                عزيزي<t t-out=\"object.tenancy_id.name\"></t>، رحلتك تبدأ هنا.\n"
"                            </strong>\n"
"<br/>\n"
"                            مرحبًا بك في مساحتك الجديدة، ويسعدنا وجودك معنا. من فضلك خذ لحظة ل\n"
"                            قم بمراجعة ملف PDF الخاص بتفاصيل العقد المرفق للتأكد من صحة جميع المعلومات.\n"
"                            إذا كان لديك أي أسئلة، فريقنا هنا لمساعدتك.\n"
"                        </p>\n"
"</div>\n"
"<p style=\"color: #181C32; font-size: 18px; font-weight: 600; margin-bottom: 15px;\">\n"
"<span t-esc=\"object.company_id.section_title\">\n"
"                            عقد الإيجار\n"
"                        </span>\n"
"</p>\n"
"<table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"width: 80%; max-width: 500px; background-color: #F9F9F9; border-radius: 12px; border-collapse: separate; padding: 20px;\">\n"
" الخطوة 1 \n"
"<tr>\n"
"<td>\n"
"<div style=\"margin-right:10px; background: #fff; width: 40px; height: 40px; text-align: center; font-size: 17px; color: #50cd89; font-weight: 600; border-radius: 50%; display: flex; align-items: center; justify-content: center;\">\n"
"<span>1</span>\n"
"</div>\n"
"</td>\n"
"<td style=\"text-align: left; padding: 15px 0; border-bottom: 1px dashed #E4E6EF;\">\n"
"<div style=\"color: #181C32; font-size: 14px; font-weight: 600; text-decoration: none; font-family: Arial, sans-serif;\">\n"
"                                    تفاصيل العقار\n"
"                                </div>\n"
"<p style=\"color: #5E6278; font-size: 13px; font-weight: 500; margin: 5px 0 0 0; line-height: 1.4;\">\n"
"<span style=\"font-weight:700;\">\n"
"<t t-out=\"object.property_id.name\"></t>\n"
"</span>\n"
"</p>\n"
"<p style=\"color: #5E6278; font-size: 13px; font-weight: 500; margin: 5px 0 0 0; line-height: 1.4;\">\n"
"<strong>يكتب :</strong>\n"
"<span>\n"
"<span t-field=\"object.property_type\"></span>\n"
"                                        ,\n"
"                                        <span t-field=\"object.property_subtype_id.name\"></span>\n"
"</span>\n"
"</p>\n"
"<p style=\"color: #5E6278; font-size: 13px; font-weight: 500; margin: 5px 0 0 0; line-height: 1.4;\" t-if=\"object.property_id.street or object.property_id.street2 or object.property_id.city_id or object.property_id.state_id or object.property_id.zip or object.property_id.country_id\">\n"
"<strong>عنوان :</strong>\n"
"<span>\n"
"<t t-esc=\"', '.join(filter(None, [                                             object.property_id.street or '',                                             object.property_id.street2 or '',                                             object.property_id.city_id.name or '',                                             object.property_id.state_id and object.property_id.state_id.name or '',                                             object.property_id.zip or '',                                             object.property_id.country_id.name or '',                                         ]))\"></t>\n"
"</span>\n"
"</p>\n"
"</td>\n"
"</tr>\n"
" الخطوة 2 \n"
"<tr>\n"
"<td>\n"
"<div style=\"margin-right:10px; background: #fff; width: 40px; height: 40px; text-align: center; font-size: 17px; color: #50cd89; font-weight: 600; border-radius: 50%; display: flex; align-items: center; justify-content: center;\">\n"
"<span>2</span>\n"
"</div>\n"
"</td>\n"
"<td style=\"text-align: left; padding: 15px 0;\">\n"
"<div style=\"color: #181C32; font-size: 14px; font-weight: 600; text-decoration: none; font-family: Arial, sans-serif;\">\n"
"                                    تفاصيل العقد\n"
"                                </div>\n"
"<p style=\"color: #5E6278; font-size: 13px; font-weight: 500; margin: 5px 0 0 0; line-height: 1.4;\">\n"
"<strong>مدة :</strong>\n"
"<span>\n"
"<t t-out=\"object.start_date\"></t>\n"
"                                        -\n"
"                                        <t t-out=\"object.end_date\"></t>\n"
"</span>\n"
"<br/>\n"
"<strong>إيجار :</strong>\n"
"<span t-field=\"object.total_rent\"></span>\n"
"                                    /\n"
"                                    <span t-field=\"object.rent_unit\"></span>\n"
"<br/>\n"
"<strong>إيداع الضمان :</strong>\n"
"<span t-field=\"object.deposit_amount\"></span>\n"
"</p>\n"
"</td>\n"
"</tr>\n"
"</table>\n"
"<div align=\"center\" style=\"font-size: 13px; text-align:center; padding: 0 10px 10px 10px; font-weight: 500; color: #A1A5B7; font-family:Arial,Helvetica,sans-serif\" valign=\"center\">\n"
"<p style=\"color:#5E6278; font-size: 16px; font-weight: 600; margin-bottom:9px\">\n"
"                            يرجى الرجوع إلى الوثيقة المرفقة لمزيد من التفاصيل.\n"
"                        </p>\n"
"<p>\n"
"<strong>تسرني مساعدتك</strong>\n"
"<br/>\n"
