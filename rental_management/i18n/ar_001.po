"                                اسم العقار :\n"
"                                <strong>\n"
"<span t-field=\"object.property_id.name\"></span>\n"
"</strong>\n"
"</li>\n"
"<li>\n"
"                                مبلغ الحجز :\n"
"                                <strong>\n"
"<span t-field=\"object.book_price\"></span>\n"
"</strong>\n"
"</li>\n"
"<li>\n"
"                                مرجع الحجز. :\n"
"                                <strong>\n"
"<span t-field=\"object.sold_seq\"></span>\n"
"</strong>\n"
"</li>\n"
"</ul>\n"
"</li>\n"
"</ul>\n"
"<br/>\n"
"<p>\n"
"                    سنتابع الآن المستندات والإجراءات اللازمة لإتمام المعاملة. لدينا\n"
"                    سيتصل بك الفريق قريبًا لتقديم المزيد من التعليمات. إذا كان لديك أي أسئلة أو\n"
"                    المخاوف، لا تترددوا في الاتصال بنا.\n"
"                    <strong>\n"
"                        نشكرك على اهتمامك بالعقار، ونتطلع إلى العمل معك.\n"
"                    </strong>\n"
"</p>\n"
"<h6>\n"
"                    أطيب التحيات\n"
"                </h6>\n"
"<h5>\n"
"<strong>\n"
"<t t-out=\"object.company_id.name\"></t>\n"
"</strong>\n"
"</h5>\n"
"<hr/>\n"
"<span>\n"
"<t t-out=\"object.company_id.phone\"></t>\n"
"<br/>\n"
"<t t-out=\"object.company_id.email\"></t>\n"
"<br/>\n"
"<t t-out=\"object.company_id.website\"></t>\n"
"</span>\n"

#. module: rental_management
#: model:mail.template,body_html:rental_management.sale_invoice_payment_mail_template
msgid ""
"<table style=\"width:100%\">\n"
"                    <tr>\n"
"                        <td> Dear Tenant\n"
