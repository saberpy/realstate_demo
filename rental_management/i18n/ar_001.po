"                    <t t-out=\"object.company_id.phone\"/>\n"
"                    <br/>\n"
"                    <t t-out=\"object.company_id.email\"/>\n"
"                    <br/>\n"
"                    <t t-out=\"object.company_id.website\"/>\n"
"                </span>\n"
"            "
msgstr ""
"<table style=\"width:100%\">\n"
"<tr>\n"
"<td>\n"
"                            عزيزي المشتري\n"
"                            <h4>\n"
"<strong>\n"
"<t t-out=\"object.customer_id.name\"></t>,\n"
"                                </strong>\n"
"</h4>\n"
"</td>\n"
"</tr>\n"
"</table>\n"
"<hr/>\n"
"<p>\n"
"                    يسعدنا إبلاغك بحجزك للعقار\n"
"                    <strong>\n"
"<t t-out=\"object.property_id.name\"></t>\n"
"</strong>\n"
"                    لقد كان ناجحا.\n"
"                </p>\n"
"<ul>\n"
