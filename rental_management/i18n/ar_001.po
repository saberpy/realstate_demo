"                                </div>\n"
"                            </td>\n"
"                            <td style=\"text-align: left; padding: 15px 0;\">\n"
"                                <a href=\"#\" style=\"color: #181C32; font-size: 14px; font-weight: 600; text-decoration: none; font-family: Arial, sans-serif;\">\n"
