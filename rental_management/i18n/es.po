#. module: rental_management
#: model:mail.template,body_html:rental_management.property_brochure_details_mail_template
msgid ""
"<style>html,body { padding:0; margin:0; font-family: Inter, Helvetica, \"sans-serif\"; } a:hover { color:\n"
"                    #009ef7; }\n"
"                </style>\n"
"                <body><div style=\"font-family: Arial, sans-serif; font-size: 14px; color: #333;text-align:center;\">\n"
"                    <img t-attf-src=\"data:image/*;base64,{{object.company_id.logo}}\" style=\"border-radius: 12px;\" alt=\"Company Logo\" height=\"60\"/>\n"
"                    <strong>\n"
"                        <div t-out=\"object.company_id.name\" style=\"margin:10px 0px;\"/>\n"
"                    </strong>\n"
"                    <div style=\"margin-bottom: 15px\">\n"
"                        <img t-if=\"object.company_id.mail_template_image\" t-attf-src=\"/web/image/res.company/{{object.company_id.id}}/mail_template_image\" alt=\"Logo\" style=\"height:120px;width:120px;\"/>\n"
"\n"
"                        <img t-else=\"\" src=\"/rental_management/static/src/img/icon-positive-vote.png\" alt=\"Logo\"/>\n"
"                    </div>\n"
"                    <div style=\"font-size: 14px; font-weight: 500; margin-bottom: 27px; font-family:Arial,Helvetica,sans-serif;\">\n"
"                        <p style=\"margin-bottom:9px; color:#181C32; font-size: 22px; font-weight:700\">\n"
"                            <span t-esc=\"object.company_id.property_mail_template_title\">\n"
"                                Discover Your Ideal Property\n"
"                            </span>\n"
"                        </p>\n"
"                        <p style=\"margin:0px 20px 2px 20px;color:#7E8299\">\n"
"                            <span t-esc=\"object.company_id.property_mail_template_description\">\n"
"                                Ready-to-move property featuring quality construction, prime location, and excellent\n"
"                                lifestyle amenities.\n"
"                            </span>\n"
"                        </p>\n"
"                    </div>\n"
"                    <a t-att-href=\"object.env.context.get('property_brochure_link')\" style=\"background-color:#50cd89;color:white;padding:10px 20px;text-decoration:none;border-radius:5px;\">\n"
"                        Explore Property\n"
"                    </a>\n"
"                    <br/>\n"
"                    <br/>\n"
"                    <p style=\"color: #181C32; font-size: 18px; font-weight: 600; margin-bottom: 15px;\">\n"
"                        <span t-esc=\"object.company_id.section_title\">\n"
"                            What's New?\n"
"                        </span>\n"
"                    </p>\n"
"                    <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"width: 100%; max-width: 500px; background-color: #F9F9F9; border-radius: 12px; border-collapse: separate; padding: 20px;\">\n"
"                        <!-- Step 1 -->\n"
"                        <tr>\n"
"                            <td>\n"
"                                <div style=\"margin-right:10px; background: #fff; width: 40px; height: 40px; text-align: center; font-size: 17px; color: #50cd89; font-weight: 600; border-radius: 50%; display: flex; align-items: center; justify-content: center;\">\n"
"                                    <span>1</span>\n"
"                                </div>\n"
"                            </td>\n"
"                            <td style=\"text-align: left; padding: 15px 0; border-bottom: 1px dashed #E4E6EF;\">\n"
"                                <a href=\"#\" style=\"color: #181C32; font-size: 14px; font-weight: 600; text-decoration: none; font-family: Arial, sans-serif;\">\n"
"                                    <span t-esc=\"object.company_id.property_mail_section_one_title\">\n"
"                                        Review the Digital Brochure\n"
"                                    </span>\n"
"                                </a>\n"
"                                <p style=\"color: #5E6278; font-size: 13px; font-weight: 500; margin: 5px 0 0 0; line-height: 1.4;\">\n"
"                                    <span t-esc=\"object.company_id.property_mail_section_one_description\">\n"
"                                        Dive into the high-resolution gallery, floor plans, and neighborhood insights.\n"
"                                        Every detail of your potential new home is just a click away.\n"
"                                    </span>\n"
"                                </p>\n"
"                            </td>\n"
"                        </tr>\n"
"                        <!-- Step 2 -->\n"
"                        <tr>\n"
"                            <td>\n"
"                                <div style=\"margin-right:10px; background: #fff; width: 40px; height: 40px; text-align: center; font-size: 17px; color: #50cd89; font-weight: 600; border-radius: 50%; display: flex; align-items: center; justify-content: center;\">\n"
"                                    <span>2</span>\n"
"                                </div>\n"
"                            </td>\n"
"                            <td style=\"text-align: left; padding: 15px 0; border-bottom: 1px dashed #E4E6EF;\">\n"
"                                <a href=\"#\" style=\"color: #181C32; font-size: 14px; font-weight: 600; text-decoration: none; font-family: Arial, sans-serif;\">\n"
"                                    <span t-esc=\"object.company_id.property_mail_section_two_title\">\n"
"                                        Schedule a Private Tour\n"
"                                    </span>\n"
"                                </a>\n"
"                                <p style=\"color: #5E6278; font-size: 13px; font-weight: 500; margin: 5px 0 0 0; line-height: 1.4;\">\n"
"                                    <span t-esc=\"object.company_id.property_mail_section_two_description\">\n"
"                                        Nothing beats the feeling of walking through the front door. Pick a time that\n"
"                                        suits your schedule for a personalized, one-on-one viewing.\n"
"                                    </span>\n"
"                                </p>\n"
"                            </td>\n"
"                        </tr>\n"
"                        <!-- Step 3 -->\n"
"                        <tr>\n"
"                            <td>\n"
"                                <div style=\"margin-right:10px; background: #fff; width: 40px; height: 40px; text-align: center; font-size: 17px; color: #50cd89; font-weight: 600; border-radius: 50%; display: flex; align-items: center; justify-content: center;\">\n"
"                                    <span>3</span>\n"
"                                </div>\n"
"                            </td>\n"
"                            <td style=\"text-align: left; padding: 15px 0;\">\n"
"                                <a href=\"#\" style=\"color: #181C32; font-size: 14px; font-weight: 600; text-decoration: none; font-family: Arial, sans-serif;\">\n"
"                                    <span t-esc=\"object.company_id.property_mail_section_three_title\">\n"
"                                        Get Your Questions Answered\n"
"                                    </span>\n"
"                                </a>\n"
"                                <p style=\"color: #5E6278; font-size: 13px; font-weight: 500; margin: 5px 0 0 0; line-height: 1.4;\">\n"
"                                    <span t-esc=\"object.company_id.property_mail_section_three_description\">\n"
"                                        Whether it’s about financing options or local school districts, our team is\n"
"                                        ready to provide the data you need to make a confident decision.\n"
"                                    </span>\n"
"                                </p>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </table>\n"
"                    <div align=\"center\" valign=\"center\" style=\"font-size: 13px; text-align:center; padding: 0 10px 10px 10px; font-weight: 500; color: #A1A5B7; font-family:Arial,Helvetica,sans-serif\">\n"
"                        <p style=\"color:#5E6278; font-size: 16px; font-weight: 600; margin-bottom:9px\">\n"
"                            It’s all about finding home!\n"
"                        </p>\n"
"                        <p>\n"
"                            <strong>Happy to Help</strong>\n"
"                            <br/>\n"
"                            Have a question or need help? We’re always happy to assist you.\n"
"                            <br/>\n"
"                            <t t-if=\"object.company_id.phone\">\n"
"                                <a t-attf-href=\"tel:{{ object.company_id.phone }}\">\n"
"                                    <span t-field=\"object.company_id.phone\" style=\"font-size:13px;\"/>\n"
"                                </a>\n"
"                                |\n"
"                            </t>\n"
"                            <t t-if=\"object.company_id.email\">\n"
"                                <a t-attf-href=\"mailto:{{ object.company_id.email }}\">\n"
"                                    <span t-field=\"object.company_id.email\" style=\"font-size:13px;\"/>\n"
"                                </a>\n"
"                                |\n"
"                            </t>\n"
"                            <a href=\"${object.company_id.website%20or%20'#'}\" target=\"_blank\">\n"
"                                <span t-field=\"object.company_id.website\" style=\"font-size:13px;\"/>\n"
"                            </a>\n"
"                        </p>\n"
"                    </div>\n"
"                    <div style=\"margin-bottom:20px;\">\n"
"                        <div align=\"center\" valign=\"center\" style=\"text-align:center; padding-bottom: 20px;\">\n"
"                            <a t-attf-href=\"{{ object.company_id.social_linkedin or '#' }}\" target=\"_blank\">\n"
"                                <img alt=\"Logo\" src=\"/rental_management/static/src/img/icon-linkedin.png\"/>\n"
"                            </a>\n"
"                            <a t-attf-href=\"{{ object.company_id.social_facebook or '#' }}\" target=\"_blank\">\n"
"                                <img alt=\"Logo\" src=\"/rental_management/static/src/img/icon-facebook.png\"/>\n"
"                            </a>\n"
"                            <a t-attf-href=\"{{ object.company_id.social_twitter or '#' }}\" target=\"_blank\">\n"
"                                <img alt=\"Logo\" src=\"/rental_management/static/src/img/icon-twitter.png\"/>\n"
"                            </a>\n"
"                        </div>\n"
"                    </div>\n"
"                </div>\n"
"            </body>"
